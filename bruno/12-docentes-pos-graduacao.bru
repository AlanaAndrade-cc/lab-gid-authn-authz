meta {
  name: 12 - Docentes com token de pós-graduação
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/docentes
}

headers {
  Authorization: Bearer {{posToken}}
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("mensagem de acesso negado", function () {
    expect(res.getBody().detail).to.equal("Acesso negado");
  });
}
