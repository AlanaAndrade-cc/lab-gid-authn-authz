meta {
  name: 13 - Login com usuário inexistente
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/login
}

headers {
  content-type: application/x-www-form-urlencoded
}

body {
  username=naoexiste&password=qualquer
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("mensagem de credenciais inválidas", function () {
    expect(res.getBody().detail).to.equal("Credenciais inválidas");
  });
}
