meta {
  name: 03 - Login inválido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
}

headers {
  content-type: application/x-www-form-urlencoded
}

body {
  username=dalton&password=errada
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("mensagem de credenciais inválidas", function () {
    expect(res.getBody().detail).to.equal("Credenciais inválidas");
  });
}
