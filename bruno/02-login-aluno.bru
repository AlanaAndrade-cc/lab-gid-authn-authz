meta {
  name: 02 - Login aluno
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
}

headers {
  content-type: application/x-www-form-urlencoded
}

body {
  username=alana&password=senha123
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("studentToken", res.getBody().access_token);
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("campos do token", function () {
    const body = res.getBody();
    expect(body).to.have.property("access_token");
    expect(body.token_type).to.equal("bearer");
    expect(body.expires_in).to.equal(1800);
  });

  test("token do aluno capturado", function () {
    expect(res.getBody().access_token).to.be.a("string");
  });
}
